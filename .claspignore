# Keep heavy game files out of the Apps Script push.
# Apps Script projects are flat and large HTML games often fail to import.
games/
tools/

# Node-only server; clashes with index.gs (both map to remote name "index").
index.js

# Never push repo metadata, workflows, or local runtime files.
.git/**
.github/**
.gitignore
*.md
node_modules/**
dist/**
*.log